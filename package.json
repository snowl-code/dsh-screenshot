{
  "name": "dsh-screenshot",
  "version": "0.2.1",
  "description": "在对话框里一键截图：点一下，框选屏幕区域，截图直接进入输入框草稿，随打随问。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "screenshot",
    "composer",
    "web-ui",
    "macos",
    "global-shortcut"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "scripts": {
    "test": "node test/client-smoke.mjs",
    "test:host": "node test/host-smoke.mjs",
    "build:helper": "./helper/build.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/8gvyzdywt4-art/dsh-screenshot.git"
  },
  "homepage": "https://github.com/8gvyzdywt4-art/dsh-screenshot#readme",
  "bugs": {
    "url": "https://github.com/8gvyzdywt4-art/dsh-screenshot/issues"
  }
}
